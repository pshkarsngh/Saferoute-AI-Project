# SafeRoute AI — environment variable template (placeholders only)
# Copy this file to `.env` and fill in real values locally.
# `.env` is git-ignored (Rule 13). NEVER commit real secrets or credentials.
# This template intentionally contains NO real values.

# --- Live provider selection (optional; sensible defaults in config/app.yaml) ---
# routing: osrm | mock
SAFEROUTE_ROUTING_PROVIDER=
# facilities: overpass | mock
SAFEROUTE_FACILITIES_PROVIDER=
# imagery: mapillary | workspace_dashcam_v1
SAFEROUTE_IMAGERY_SOURCE=
# PHASE_23B: local sample imagery is NOT geographically matched; keep DEMO off
# (default) so missing imagery is reported honestly as unmatched/unassessed.
SAFEROUTE_IMAGERY_DEMO_MODE=
# geocoding: nominatim | mock
SAFEROUTE_GEOCODING_PROVIDER=
SAFEROUTE_GEOCODING_ENABLED=
SAFEROUTE_GEOCODING_COUNTRY_CODES=

# --- Server ---
SAFEROUTE_HOST=
SAFEROUTE_PORT=

# --- Routing provider (OSRM; keyless OSM, no key required) ---
ROUTING_PROVIDER=
ROUTING_API_KEY=

# --- Geocoding (Nominatim; keyless OSM, no key required) ---
NOMINATIM_BASE_URL=

# --- Street imagery (Mapillary; REQUIRED for live imagery) ---
# Get a free token at https://www.mapillary.com/dashboard/developers
MAPILLARY_ACCESS_TOKEN=
SAFEROUTE_MAPILLARY_MAX_IMAGES=

# --- Facilities provider (Overpass/OSM is keyless; reserved for paid providers) ---
FACILITIES_PROVIDER=
FACILITIES_API_KEY=

# --- Database (SQLite is used by default; MySQL reserved for later) ---
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

# --- Local LLM (Ollama; leave blank to use the deterministic fallback) ---
OLLAMA_BASE_URL=
OLLAMA_MODEL=
SAFEROUTE_LLM_ENABLED=
# Bounded wait (seconds) for the local model. Default 45 (config/app.yaml).
SAFEROUTE_LLM_TIMEOUT_SECONDS=

# --- Shared outbound HTTP identity (used for OSM/Mapillary requests) ---
SAFEROUTE_USER_AGENT=
