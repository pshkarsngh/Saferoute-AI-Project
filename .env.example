# SafeRoute AI — environment variable template (placeholders only)
# Copy this file to `.env` and fill in real values locally.
# `.env` is git-ignored (Rule 13). NEVER commit real secrets or credentials.
# This template intentionally contains NO real values.

# --- Routing provider (provider not yet selected; names reserved) ---
ROUTING_PROVIDER=
ROUTING_API_KEY=

# --- Facilities provider (optional; reserved for later phases) ---
FACILITIES_PROVIDER=
FACILITIES_API_KEY=

# --- Database (MySQL; reserved for later phases) ---
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

# --- Local LLM (Ollama; reserved for later phases) ---
OLLAMA_BASE_URL=
